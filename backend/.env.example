# ---- MongoDB Atlas ----
# Create a free cluster at https://www.mongodb.com/cloud/atlas, add your IP under
# Network Access, create a database user, then paste the connection string here.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
# Use bank_dev for development and bank_test for automated tests.
MONGODB_DB_NAME=bank_dev

# ---- JWT secrets ----
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- Server / browser ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# ---- Banking limits (amounts in paisa; 100 paisa = BDT 1) ----
DEPOSIT_MIN_PAISA=1000
DEPOSIT_MAX_PAISA=50000000
WITHDRAW_MIN_PAISA=1000
WITHDRAW_MAX_PAISA=10000000
WITHDRAW_DAILY_LIMIT_PAISA=5000000
TRANSFER_MIN_PAISA=1000
TRANSFER_MAX_PAISA=10000000
WITHDRAW_CANCEL_WINDOW_SECONDS=120
# Money exchange: BDT -> foreign currency. Amounts are in paisa; rates map a
# foreign currency code to its units per 1 BDT, e.g. {"USD":0.0085} means 1 BDT = 0.0085 USD.
EXCHANGE_MIN_PAISA=1000
EXCHANGE_MAX_PAISA=10000000
EXCHANGE_RATES={"USD":0.0085}
# Every 15 seconds. Use standard 5-field cron syntax for less frequent runs.
PENDING_WITHDRAWAL_CRON=*/15 * * * * *
