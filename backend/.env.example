# ---- Server ----
PORT=10000
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart_atm_db?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=atm_token

# ---- CORS ----
# Exact frontend origin (no trailing slash). https://smart-atm-three.vercel.app
# is always allowed; set this for local dev or a custom domain.
CLIENT_URL=http://localhost:3000

# ---- Seed defaults (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@smartatm.com
SEED_ADMIN_PASSWORD=admin123
